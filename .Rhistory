install.packages("dplyr")
library(dplyr)
# Step 0: Create the CSV file
attendance_data <- data.frame(
StudentID = c(101, 102, 103, 104, 105),
Name = c("Amit", "Neha", "Rahul", "Sneha", "Karan"),
AttendancePercentage = c(82, 67, 91, 74, 88)
)
write.csv(attendance_data, "attendance.csv", row.names = FALSE)
# Read the CSV file
attendance <- read.csv("attendance.csv")
# 1) Students with attendance below 75%
below_75 <- attendance[attendance$AttendancePercentage < 75, ]
print("Students with attendance below 75%:")
print(below_75)
# 2) Add Eligibility column
attendance$Eligibility <- ifelse(
attendance$AttendancePercentage >= 75,
"Eligible",
"Not Eligible"
)
print("Updated data with Eligibility column:")
print(attendance)
# 3) Export updated data to a new CSV with row names
write.csv(attendance, "export_attendance.csv", row.names = TRUE)
print("Updated data exported to 'export_attendance.csv'.")
# 4) Average AttendancePercentage of Eligible students
avg_attendance <-
mean(attendance$AttendancePercentage[attendance$Eligibility == "Eligible"])
print(paste("Average Attendance of Eligible students:",
round(avg_attendance, 2)))
# 5) Count number of Eligible and Not Eligible students
num_eligible <- sum(attendance$Eligibility == "Eligible")
num_not_eligible <- sum(attendance$Eligibility == "Not Eligible")
print(c(Eligible = num_eligible, Not_Eligible = num_not_eligible))
install.packages("tidyr")
library(tidyr)
# Load required libraries
library(dplyr)
library(tidyr)
# Create the dataset
data <- data.frame(
Country_State = c(
"India","India","India",
"Tamil Nadu","Tamil Nadu","Tamil Nadu",
"Kerala","Kerala","Kerala",
"Maharashtra","Maharashtra","Maharashtra"
),
Year = c(2018,2019,2020,2018,2019,2020,2018,2019,2020,2018,2019,2020),
Literacy_Male = c(82.1,83.0,84.2,87.5,88.3,89.0,96.1,96.4,96.8,90.4,91.1,92.0),
Literacy_Female = c(65.5,66.8,68.1,73.2,74.6,75.9,92.3,92.8,93.2,79.2,80.6,82.0),
Enrollment_Primary = c(95.2,96.0,94.5,98.1,98.5,97.8,99.2,99.4,99.0,97.0,97.6,96.8),
Enrollment_Secondary = c(74.3,75.6,73.9,82.4,83.7,82.9,88.6,89.1,88.4,80.5,81.9,80.7),
Dropout_Rate = c(4.8,4.5,5.2,2.6,2.4,2.9,1.2,1.1,1.4,3.1,2.9,3.4)
)
data2 <- data %>%
mutate(
Literacy_Gap = Literacy_Male - Literacy_Female,
Enrollment_Change = Enrollment_Primary - Enrollment_Secondary
) %>%
filter(Literacy_Gap > 10, Dropout_Rate < 4)
print(data2)
# State-wise averages and ranking
state_summary <- data %>%
group_by(Country_State) %>%
summarise(
Avg_Male = mean(Literacy_Male),
Avg_Female = mean(Literacy_Female),
Avg_Dropout = mean(Dropout_Rate),
Avg_Gap = mean(Literacy_Male - Literacy_Female)
) %>%
arrange(desc(Avg_Gap)) %>%
slice_head(n = 2)
print(state_summary)
# Wide to long (literacy only)
long_data <- data %>%
pivot_longer(
cols = c(Literacy_Male, Literacy_Female,
Enrollment_Primary, Enrollment_Secondary),
names_to = "Indicator",
values_to = "Value"
) %>%
filter(grepl("Literacy", Indicator))
print(long_data)
# Smallest gender literacy gap
gap_summary <- data %>%
group_by(Country_State) %>%
summarise(Gap = mean(Literacy_Male - Literacy_Female)) %>%
arrange(Gap) %>%
slice(1)
print(gap_summary)
# Gender Equality Index
gei <- data %>%
group_by(Country_State) %>%
summarise(
Literacy_Male = mean(Literacy_Male),
Literacy_Female = mean(Literacy_Female)
) %>%
mutate(
Gender_Equality_Index = Literacy_Female / Literacy_Male
) %>%
arrange(desc(Gender_Equality_Index))
print(gei)
cat("Interpretation: Gender Equality Index alone does not fully measure educational equity because it ignores enrollment, dropout, and other socio-economic factors.\n")
library(dplyr)
library(tidyr)
library(ggplot2)
install.packages("ggplot2")
library(ggplot2)
data(starwars)
clean_sw <- starwars %>%
filter(!is.na(height), !is.na(mass), !is.na(gender)) %>%
mutate(BMI_like = mass / (height/100)^2)
summary(clean_sw$BMI_like)
top_species <- clean_sw %>%
group_by(species) %>%
summarise(
avg_height = mean(height),
avg_mass = mean(mass),
avg_BMI = mean(BMI_like)
) %>%
arrange(desc(avg_BMI)) %>%
slice_head(n = 3)
print(top_species)
species_gender_summary <- clean_sw %>%
group_by(species, gender) %>%
summarise(
avg_height = mean(height),
avg_mass = mean(mass),
.groups = "drop"
)
print(species_gender_summary)
# Lookup table
lookup <- data.frame(
homeworld = c("Tatooine","Naboo","Coruscant"),
Region = c("Outer Rim","Mid Rim","Core Worlds")
)
# Different joins
left_joined <- left_join(clean_sw, lookup, by = "homeworld")
inner_joined <- inner_join(clean_sw, lookup, by = "homeworld")
full_joined <- full_join(clean_sw, lookup, by = "homeworld")
print(dim(left_joined))
print(dim(inner_joined))
print(dim(full_joined))
# Wide to long
long_sw <- clean_sw %>%
pivot_longer(
cols = c(height, mass, BMI_like),
names_to = "Attribute",
values_to = "Value"
)
# Grouped summary
summary_sw <- long_sw %>%
group_by(species, Attribute) %>%
summarise(avg_value = mean(Value), .groups = "drop")
# Back to wide
wide_sw <- summary_sw %>%
pivot_wider(names_from = Attribute, values_from = avg_value)
print(wide_sw)
# Visualization
ggplot(summary_sw, aes(x = species, y = avg_value, fill = Attribute)) +
geom_bar(stat = "identity", position = "dodge") +
theme(axis.text.x = element_text(angle = 90, hjust = 1))
