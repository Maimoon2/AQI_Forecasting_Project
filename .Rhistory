# Step 1: Accept a numeric vector (with NA values)
num_vector <- c(45, 120, NA, 78, 200, NA, 90)
# Step 2: Remove all missing values (NA)
clean_vector <- num_vector[!is.na(num_vector)]
# Step 3: User-defined function to find maximum value
# (without using built-in max() function)
find_max <- function(vec) {
max_val <- vec[1]
for (i in vec) {
if (i > max_val) {
max_val <- i
}
}
return(max_val)
}
# Call the user-defined function
maximum_value <- find_max(clean_vector)
# Step 4: Conditional statement to check the maximum value
if (maximum_value > 100) {
result <- "High Value"
} else {
result <- "Normal Value"
}
# Step 5: Display the final result as a character string using only paste() not cat()
output <- paste("The maximum value is", maximum_value, "-", result)
print(output)
# Numeric vector representing ages of students
ages <- c(15, 18, 20, 22, 17, 19, 21, 16, 23, 18)
# 1) Extract ages less than 17 OR greater than 21
result1 <- ages[ages < 17 | ages > 21]
print(result1)
# 2) Extract ages between 18 and 22 (inclusive) but exclude 20
result2 <- ages[ages >= 18 & ages <= 22 & ages != 20]
print(result2)
# Step 0: Store temperatures in a list
temperatures <- list(
Delhi = c(25, 28, 30, 29, 27, 26, 31),
Mumbai = c(32, 34, 33, 35, 36, 32, 34),
Kolkata = c(28, 30, 29, 31, 30, 29, 32)
)
# Step 1: Define user-defined function
summary_stats <- function(x) {
list(
Mean = mean(x),
Max = max(x),
Min = min(x),
DaysAbove30 = sum(x > 30)
)
}
# Step 2: Apply summary_stats() using lapply()
city_summary <- lapply(temperatures, summary_stats)
# Step 3: Add HotDaysFlag to each city summary
city_summary <- lapply(city_summary, function(x) {
x$HotDaysFlag <- x$Mean > 30
x
})
# Display the summary
print(city_summary)
