col="blue",
lwd=2)
points(time_index,
predicted_values,
col="blue",
pch=16)
legend("topleft",
legend=c("Actual PM2.5","Predicted PM2.5"),
col=c("red","blue"),
lty=1,
lwd=2)
dev.off()
cat("Actual vs Predicted plot saved\n")
# -----------------------------------------
# STEP 11: Save Forecast Data
# -----------------------------------------
forecast_df <- data.frame(
time_index = seq_along(test_ts),
actual_pm25 = as.numeric(test_ts),
predicted_pm25 = as.numeric(forecast_values$mean),
error = abs(as.numeric(test_ts) - as.numeric(forecast_values$mean))
)
write.csv(
forecast_df,
"results/forecast_results_overall.csv",
row.names = FALSE
)
cat("Forecast CSV saved\n")
cat("Overall forecasting completed successfully\n")
# ====================================
# CITY-WISE ARIMA FORECASTING SCRIPT
# ====================================
library(readr)
library(dplyr)
library(forecast)
library(ggplot2)
library(tseries)
cat("Starting City-wise ARIMA Forecasting\n")
setwd("C:/Users/OMEN/Desktop/AQI-Analysis-Project")
# ---------------------------------
# Load Dataset
# ---------------------------------
data <- read_csv("data/clean/weather_aqi_clean.csv")
data$date <- as.POSIXct(data$timestamp, origin="1970-01-01")
cities <- unique(data$city)
print(cities)
all_forecasts <- data.frame()
# ---------------------------------
# Loop through each city
# ---------------------------------
for(city_name in cities){
cat("\nProcessing:", city_name,"\n")
city_data <- data %>%
filter(city == city_name)
# ---------------------------------
# Create daily PM2.5 trend
# ---------------------------------
daily_data <- city_data %>%
group_by(date = as.Date(date)) %>%
summarise(pm25_daily = mean(pm2_5, na.rm=TRUE)) %>%
arrange(date)
if(nrow(daily_data) < 30){
cat("Skipping city (not enough data)\n")
next
}
# ---------------------------------
# Trend Plot for City
# ---------------------------------
trend_plot <- ggplot(daily_data, aes(x=date, y=pm25_daily)) +
geom_line(color="darkgreen", linewidth=1) +
labs(
title=paste("PM2.5 Pollution Trend -", city_name),
x="Date",
y="Average PM2.5",
caption="Daily pollution trend for city"
) +
theme_minimal()
ggsave(
paste0("results/forecast_plots/trend_",city_name,".png"),
plot=trend_plot,
width=10,
height=6
)
# ---------------------------------
# Convert to time series
# ---------------------------------
ts_data <- ts(daily_data$pm25_daily, frequency=7)
train_size <- floor(0.8 * length(ts_data))
train_ts <- ts_data[1:train_size]
test_ts  <- ts_data[(train_size+1):length(ts_data)]
# ---------------------------------
# Stationarity Test
# ---------------------------------
print(adf.test(train_ts))
# ---------------------------------
# Train ARIMA Model
# ---------------------------------
model <- auto.arima(train_ts, seasonal=TRUE)
cat("Selected Model:\n")
print(model)
# ---------------------------------
# Forecast
# ---------------------------------
forecast_values <- forecast(model, h=length(test_ts))
# ---------------------------------
# Model Evaluation
# ---------------------------------
rmse <- sqrt(mean((test_ts - forecast_values$mean)^2))
mae  <- mean(abs(test_ts - forecast_values$mean))
mape <- mean(abs((test_ts - forecast_values$mean)/test_ts))*100
cat("Model Performance for",city_name,"\n")
cat("RMSE:",rmse,"\n")
cat("MAE:",mae,"\n")
cat("MAPE:",mape,"%\n")
# ---------------------------------
# Actual vs Predicted Plot
# ---------------------------------
actual_values <- as.numeric(test_ts)
predicted_values <- as.numeric(forecast_values$mean)
time_index <- 1:length(actual_values)
png(
paste0("results/forecast_plots/comparison_",city_name,".png"),
width=900,
height=600
)
plot(time_index,
actual_values,
type="l",
col="red",
lwd=2,
main=paste("Actual vs Predicted PM2.5 -", city_name),
xlab="Time Index (Days)",
ylab="PM2.5 Concentration")
lines(time_index,
predicted_values,
col="blue",
lwd=2)
points(time_index,
predicted_values,
col="blue",
pch=16)
legend("topleft",
legend=c("Actual PM2.5","Predicted PM2.5"),
col=c("red","blue"),
lty=1,
lwd=2)
dev.off()
# ---------------------------------
# Save forecast data
# ---------------------------------
forecast_df <- data.frame(
city = city_name,
time_index = time_index,
actual_pm25 = actual_values,
predicted_pm25 = predicted_values,
error = abs(actual_values - predicted_values)
)
all_forecasts <- rbind(all_forecasts, forecast_df)
}
# ---------------------------------
# Save Combined CSV
# ---------------------------------
write.csv(
all_forecasts,
"results/forecast_results_citywise.csv",
row.names = FALSE
)
cat("\nCity-wise forecasting completed\n")
cat("CSV saved: results/forecast_results_citywise.csv\n")
# =========================================
# OVERALL ARIMA FORECAST SCRIPT
# =========================================
library(readr)
library(dplyr)
library(forecast)
library(ggplot2)
library(tseries)
cat("Starting Overall ARIMA Forecasting...\n")
setwd("C:/Users/OMEN/Desktop/AQI-Analysis-Project")
# -----------------------------------------
# Load dataset
# -----------------------------------------
data <- read_csv("data/clean/weather_aqi_clean.csv")
data$date <- as.POSIXct(data$timestamp, origin="1970-01-01")
# -----------------------------------------
# Create Daily PM2.5 Trend
# -----------------------------------------
daily_data <- data %>%
group_by(date = as.Date(date)) %>%
summarise(pm25_daily = mean(pm2_5, na.rm = TRUE)) %>%
arrange(date)
# -----------------------------------------
# 1️⃣ TREND PLOT
# -----------------------------------------
trend_plot <- ggplot(daily_data, aes(x=date, y=pm25_daily)) +
geom_line(color="blue", linewidth=1) +
labs(
title="Overall PM2.5 Pollution Trend",
x="Date",
y="Average PM2.5 Concentration",
caption="Shows how pollution changes over time"
) +
theme_minimal()
ggsave("results/forecast_plots/overall_trend.png", trend_plot, width=10, height=6)
# -----------------------------------------
# Time Series
# -----------------------------------------
ts_data <- ts(daily_data$pm25_daily, frequency=7)
train_size <- floor(0.8 * length(ts_data))
train_ts <- ts_data[1:train_size]
test_ts  <- ts_data[(train_size+1):length(ts_data)]
# -----------------------------------------
# Stationarity Test
# -----------------------------------------
print(adf.test(train_ts))
# -----------------------------------------
# Train ARIMA
# -----------------------------------------
model <- auto.arima(train_ts, seasonal=TRUE)
print(model)
# -----------------------------------------
# Forecast
# -----------------------------------------
forecast_values <- forecast(model, h=length(test_ts))
# -----------------------------------------
# Model Evaluation
# -----------------------------------------
rmse <- sqrt(mean((test_ts - forecast_values$mean)^2))
mae  <- mean(abs(test_ts - forecast_values$mean))
mape <- mean(abs((test_ts - forecast_values$mean)/test_ts))*100
cat("RMSE:",rmse,"\n")
cat("MAE:",mae,"\n")
cat("MAPE:",mape,"%\n")
# -----------------------------------------
# 2️⃣ ACTUAL VS PREDICTED PLOT
# -----------------------------------------
comparison_df <- data.frame(
time = 1:length(test_ts),
actual = as.numeric(test_ts),
predicted = as.numeric(forecast_values$mean)
)
comparison_plot <- ggplot(comparison_df) +
geom_line(aes(x=time,y=actual,color="Actual"),linewidth=1.2) +
geom_line(aes(x=time,y=predicted,color="Predicted"),linewidth=1.2) +
labs(
title="Actual vs Predicted PM2.5 (Overall)",
x="Time Index (Days)",
y="PM2.5 Concentration"
) +
scale_color_manual(values=c("Actual"="red","Predicted"="blue")) +
theme_minimal()
ggsave("results/forecast_plots/overall_comparison.png",comparison_plot,width=10,height=6)
# -----------------------------------------
# 3️⃣ PREDICTION ERROR PLOT
# -----------------------------------------
errors <- as.numeric(test_ts) - as.numeric(forecast_values$mean)
error_df <- data.frame(
time=1:length(errors),
error=errors
)
error_plot <- ggplot(error_df,aes(x=time,y=error))+
geom_line(color="purple")+
labs(
title="Prediction Error Over Time (Overall)",
x="Time Index",
y="Prediction Error (Actual - Predicted)"
)+
theme_minimal()
ggsave("results/forecast_plots/overall_error.png",error_plot,width=10,height=6)
# -----------------------------------------
# Save Forecast CSV
# -----------------------------------------
forecast_df <- data.frame(
time_index=1:length(test_ts),
actual_pm25=as.numeric(test_ts),
predicted_pm25=as.numeric(forecast_values$mean),
error=abs(as.numeric(test_ts)-as.numeric(forecast_values$mean))
)
write.csv(
forecast_df,
"results/forecast_results_overall.csv",
row.names=FALSE
)
cat("Overall forecasting completed\n")
# =========================================
# OVERALL ARIMA FORECAST SCRIPT
# =========================================
library(readr)
library(dplyr)
library(forecast)
library(ggplot2)
library(tseries)
cat("Starting Overall ARIMA Forecasting...\n")
setwd("C:/Users/OMEN/Desktop/AQI-Analysis-Project")
# -----------------------------------------
# STEP 1: Load Dataset
# -----------------------------------------
data <- read_csv("data/clean/weather_aqi_clean.csv")
data$date <- as.POSIXct(data$timestamp, origin="1970-01-01")
cat("Dataset loaded successfully\n")
# -----------------------------------------
# STEP 2: Create Daily PM2.5 Trend
# -----------------------------------------
daily_data <- data %>%
group_by(date = as.Date(date)) %>%
summarise(pm25_daily = mean(pm2_5, na.rm=TRUE)) %>%
arrange(date)
# -----------------------------------------
# STEP 3: Trend Plot
# -----------------------------------------
trend_plot <- ggplot(daily_data, aes(x=date, y=pm25_daily)) +
geom_line(color="blue", linewidth=1) +
labs(
title="Overall PM2.5 Pollution Trend",
x="Date",
y="Average PM2.5",
caption="Daily average PM2.5 across all cities"
) +
theme_minimal()
ggsave(
"results/forecast_plots/overall_trend.png",
trend_plot,
width=10,
height=6
)
# -----------------------------------------
# STEP 4: Time Series Creation
# -----------------------------------------
ts_data <- ts(daily_data$pm25_daily, frequency=7)
train_size <- floor(0.8 * length(ts_data))
train_ts <- ts_data[1:train_size]
test_ts  <- ts_data[(train_size+1):length(ts_data)]
# -----------------------------------------
# STEP 5: Stationarity Test
# -----------------------------------------
print(adf.test(train_ts))
# -----------------------------------------
# STEP 6: Train ARIMA Model
# -----------------------------------------
model <- auto.arima(train_ts, seasonal=TRUE)
cat("Selected Model:\n")
print(model)
# -----------------------------------------
# STEP 7: Forecast
# -----------------------------------------
forecast_values <- forecast(model, h=length(test_ts))
# -----------------------------------------
# STEP 8: Model Evaluation
# -----------------------------------------
rmse <- sqrt(mean((test_ts - forecast_values$mean)^2))
mae  <- mean(abs(test_ts - forecast_values$mean))
mape <- mean(abs((test_ts - forecast_values$mean)/test_ts))*100
cat("\nModel Performance Metrics\n")
cat("RMSE:", rmse, "\n")
cat("MAE :", mae, "\n")
cat("MAPE:", mape, "%\n")
# -----------------------------------------
# STEP 9: Combined Comparison + Error Plot
# -----------------------------------------
actual_values <- as.numeric(test_ts)
predicted_values <- as.numeric(forecast_values$mean)
errors <- actual_values - predicted_values
time_index <- 1:length(actual_values)
png("results/forecast_plots/overall_comparison_error.png",
width=900,
height=700)
par(mfrow=c(2,1))
# Panel 1
plot(time_index,
actual_values,
type="l",
col="red",
lwd=2,
main="Actual vs Predicted PM2.5 (Overall)",
xlab="Time Index (Days)",
ylab="PM2.5")
lines(time_index,
predicted_values,
col="blue",
lwd=2)
legend("topleft",
legend=c("Actual PM2.5","Predicted PM2.5"),
col=c("red","blue"),
lty=1,
lwd=2)
# Panel 2
plot(time_index,
errors,
type="l",
col="purple",
lwd=2,
main="Prediction Error (Actual - Predicted)",
xlab="Time Index (Days)",
ylab="Error")
abline(h=0, col="black", lty=2)
dev.off()
# -----------------------------------------
# STEP 10: Save Forecast Data
# -----------------------------------------
forecast_df <- data.frame(
time_index = time_index,
actual_pm25 = actual_values,
predicted_pm25 = predicted_values,
error = abs(actual_values - predicted_values)
)
write.csv(
forecast_df,
"results/forecast_results_overall.csv",
row.names=FALSE
)
cat("Overall forecasting completed successfully\n")
